++---
import Layout from "../layouts/Layout.astro";
import Container from "../components/shared/Container.astro";

---

<Layout title="About">
  <main class="py-32">
    <Container>
      <h1 class="text-4xl font-bold text-heading-1 mb-6">About Us</h1>
      <p class="text-lg text-heading-2 max-w-3xl">
